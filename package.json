{
  "name": "meshcore-ts",
  "version": "0.0.0",
  "description": "TypeScript library for connecting and working with MeshCore companion devices over Serial, BLE, and WiFi",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "pnpm run typecheck && eslint .",
    "lint:fix": "pnpm run typecheck && eslint . --fix",
    "format": "pnpm run lint:fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage"
  },
  "keywords": [
    "meshcore",
    "lora",
    "mesh",
    "ble",
    "serial",
    "iot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wvanderp/Meshcore-ts.git"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^50.6.17",
    "globals": "^17.4.0",
    "tsdown": "^0.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
